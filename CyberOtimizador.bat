        $sw=[Windows.Markup.XamlReader]::Load((New-Object System.Xml.XmlNodeReader $sx))
        $FDay=$sw.FindName('FDay'); $FWeek=$sw.FindName('FWeek'); $DaysWrap=$sw.FindName('DaysWrap')
        $dayBtns=@('D0','D1','D2','D3','D4','D5','D6' | ForEach-Object { $sw.FindName($_) })
        $HH=$sw.FindName('HH'); $MM=$sw.FindName('MM'); $Warn=$sw.FindName('Warn'); $Ok=$sw.FindName('Ok'); $Cx=$sw.FindName('Cx')
        # estado inicial: semanal, domingo, 12:00
        $FWeek.IsChecked=$true; $dayBtns[6].IsChecked=$true
        $setDaily={ $FDay.IsChecked=$true; $FWeek.IsChecked=$false; $DaysWrap.Opacity=0.3; $DaysWrap.IsEnabled=$false }
        $setWeekly={ $FWeek.IsChecked=$true; $FDay.IsChecked=$false; $DaysWrap.Opacity=1; $DaysWrap.IsEnabled=$true }
        $FDay.Add_Click($setDaily.GetNewClosure())
        $FWeek.Add_Click($setWeekly.GetNewClosure())
        $Cx.Add_Click({ $script:schOk=$false; $sw.Close() }.GetNewClosure())
        $Ok.Add_Click({
            $h=0; $m=0
            if(-not [int]::TryParse($HH.Text,[ref]$h) -or $h -lt 0 -or $h -gt 23){ $Warn.Text='Hora invalida (0-23).'; return }
            if(-not [int]::TryParse($MM.Text,[ref]$m) -or $m -lt 0 -or $m -gt 59){ $Warn.Text='Minutos invalidos (0-59).'; return }
            $st=('{0:D2}:{1:D2}' -f $h,$m)
            if($FDay.IsChecked){
                $script:schCmd=@{ sc='DAILY'; d=$null; st=$st; desc=("diariamente as {0}" -f $st) }
            } else {
                $days=@(); foreach($b in $dayBtns){ if($b.IsChecked){ $days+=[string]$b.Tag } }
                if($days.Count -eq 0){ $Warn.Text='Escolhe pelo menos um dia.'; return }
                $script:schCmd=@{ sc='WEEKLY'; d=($days -join ','); st=$st; desc=("as {0} ({1})" -f $st,($days -join ',')) }
            }
            $script:schOk=$true; $sw.Close()
        }.GetNewClosure())
        try{ $sw.Owner=$win }catch{}
        [void]$sw.ShowDialog()
    }catch{ $Status.Text='falhou a abrir o agendador.'; return }
    if(-not $script:schOk){ $Status.Text='Agendamento cancelado.'; return }
    try{
        $dir=Join-Path $env:ProgramData 'Otimizador'; New-Item -ItemType Directory -Force -Path $dir | Out-Null
        $cmdFile=Join-Path $dir 'limpeza.cmd'
        Set-Content -LiteralPath $cmdFile -Value "@echo off`r`ndel /f /s /q `"%TEMP%\*`" >nul 2>&1`r`ndel /f /s /q `"%WINDIR%\Temp\*`" >nul 2>&1`r`ndel /f /s /q `"%LOCALAPPDATA%\Temp\*`" >nul 2>&1" -Encoding ASCII
        $c=$script:schCmd
        if($c.sc -eq 'DAILY'){
            schtasks /Create /TN 'Otim_LimpezaSemanal' /TR "\"$cmdFile\"" /SC DAILY /ST $c.st /RL HIGHEST /F 2>$null | Out-Null
        } else {
            schtasks /Create /TN 'Otim_LimpezaSemanal' /TR "\"$cmdFile\"" /SC WEEKLY /D $c.d /ST $c.st /RL HIGHEST /F 2>$null | Out-Null
        }
        $Status.Text=('Limpeza agendada '+$c.desc+'.')
    }catch{ $Status.Text='falhou a agendar.' }
}
