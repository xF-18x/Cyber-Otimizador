function Update-System {
    try{
        Set-UsePct $SC.cpu $script:sysData.cpu
        Set-UsePct $SC.ram $script:sysData.ram
        if($script:sysData.net){ $SC.net.Val.Text=$script:sysData.net }
    }catch{}
}

